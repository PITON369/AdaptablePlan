<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="AdaptablePlan.UI.Views.PlanView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
    </UserControl.Resources>
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="16" Spacing="16" MaxWidth="1200" HorizontalAlignment="Left">

                <TextBlock Text="{Binding CurrentPlan.Title}" FontSize="18" FontWeight="SemiBold" />

            <!-- Хочу научиться -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource WantToLearn}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Learn.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Learn.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Learn.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Хочу улучшить -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource WantToImprove}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Improve.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Improve.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Improve.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Хочу попробовать -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource WantToTry}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Try.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Try.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Try.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Хочу достичь -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource WantToAchieve}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Achieve.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Achieve.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Achieve.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Сферы, которые хочу прокачать -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Spheres}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Spheres}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanSphereViewModel">
                            <Border BorderBrush="{DynamicResource WeekGridLineBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="220" Text="{Binding Name, Mode=TwoWay}" />
                                        <Button Content="✕" Padding="4,0" Command="{Binding RemoveSelfCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items.Items}" Margin="16,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlanEntryViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                    <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="16,0,0,0">
                                        <TextBox Width="220" PlaceholderText="{DynamicResource NewItem}" Text="{Binding Items.NewItemText, Mode=TwoWay}" />
                                        <Button Content="{DynamicResource Add}" Command="{Binding Items.AddCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{DynamicResource AddSphere}" HorizontalAlignment="Left"
                        Command="{Binding CurrentPlan.AddSphereCommand}" />
            </StackPanel>

            <!-- Статьи и литература -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Articles}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Articles.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Articles.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Articles.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Курсы и вебинары -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Courses}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Courses.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Courses.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Courses.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Мероприятия -->
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Events}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CurrentPlan.Events.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                <Button Content="✕" Padding="4,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox Width="280" PlaceholderText="{DynamicResource NewItem}" Text="{Binding CurrentPlan.Events.NewItemText, Mode=TwoWay}" />
                    <Button Content="{DynamicResource Add}" Command="{Binding CurrentPlan.Events.AddCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Сетка 4 недель: 7 колонок по дням, в каждой ячейке свой список планов -->
            <ItemsControl ItemsSource="{Binding CurrentPlan.Weeks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanWeekViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanDayCellViewModel">
                                        <TextBlock Text="{Binding DayName}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlanDayCellViewModel">
                                        <Border Background="{DynamicResource WeekGridHeaderBackground}"
                                                BorderBrush="{DynamicResource WeekGridLineBrush}"
                                                BorderThickness="0,0,1,1" MinHeight="90">
                                            <StackPanel Spacing="2" Margin="4">
                                                <ItemsControl ItemsSource="{Binding Items.Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PlanEntryViewModel">
                                                            <StackPanel Spacing="2">
                                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                                <Button Content="✕" Padding="2,0"
                                                                        HorizontalAlignment="Left"
                                                                        Command="{Binding RemoveCommand}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <TextBox MinWidth="60" HorizontalAlignment="Stretch"
                                                             PlaceholderText="{DynamicResource AddPlan}"
                                                             Text="{Binding Items.NewItemText, Mode=TwoWay}" />
                                                    <Button Content="+" MinWidth="28"
                                                            Command="{Binding Items.AddCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Close закреплена снизу: видна при любой прокрутке -->
        <Border Grid.Row="1" Background="{DynamicResource WeekGridHeaderBackground}" Padding="16,8">
            <Button Content="{DynamicResource Close}" HorizontalAlignment="Right" MinWidth="120"
                    Command="{Binding ClosePlanCommand}" />
        </Border>
    </Grid>
</UserControl>
