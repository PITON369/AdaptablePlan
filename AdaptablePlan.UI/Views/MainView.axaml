<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="AdaptablePlan.UI.Views.MainView"
             x:DataType="vm:MainWindowViewModel">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Mode toggle: Day / Week / Month / Year / Custom -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <RadioButton Content="{DynamicResource Day}" IsChecked="{Binding IsDayMode, Mode=TwoWay}" />
            <RadioButton Content="{DynamicResource Week}" IsChecked="{Binding IsWeekMode, Mode=TwoWay}" />
            <RadioButton Content="{DynamicResource Month}" IsChecked="{Binding IsMonthMode, Mode=TwoWay}" />
            <RadioButton Content="{DynamicResource Year}" IsChecked="{Binding IsYearMode, Mode=TwoWay}" />
            <RadioButton Content="{DynamicResource Custom}" IsChecked="{Binding IsCustomMode, Mode=TwoWay}" />
            <ComboBox x:Name="CustomPagesCombo" Margin="16,0,0,0" Width="160"
                      IsEnabled="{Binding IsCustomMode}"
                      ItemsSource="{Binding CustomPageList}"
                      SelectedItem="{Binding SelectedCustomPage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CustomPageViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedDateText}" />
            <Button Content="&lt;" Margin="16,0,0,0" Command="{Binding PreviousPeriodCommand}" />
            <Button Content="&gt;" Command="{Binding NextPeriodCommand}" />
            <Button Content="{DynamicResource Today}" Command="{Binding GoToTodayCommand}" />
            <CheckBox Content="{DynamicResource StartWeekOnMonday}"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      IsChecked="{Binding StartWeekOnMonday, Mode=TwoWay}"
                      IsVisible="{Binding IsWeekMode}" />
        </StackPanel>

        <!-- Status bar -->
        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"
                   Text="{Binding AppStatus}" />

        <!-- Single slot: code-behind swaps DayView / WeekView / MonthView / YearView / CustomPageView -->
        <ContentControl Grid.Row="2" x:Name="ScheduleHost" />

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Spacing="8" Margin="0,8,0,0">
            <Button Content="{Binding TaskActionText}"
                    Command="{Binding ToggleTaskCommand}"
                    IsEnabled="{Binding CanToggleTask}"
                    IsVisible="{Binding ShowTaskButton}" />
            <TextBlock VerticalAlignment="Center" Margin="24,0,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding TimeLeftText}" />
            <TextBlock VerticalAlignment="Center" Margin="24,0,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding SelectedTimeText}" />
            <!-- Simple timer: выбор минут (список или ручной ввод), старт;
                 после старта - отсчёт и отмена. Виден только в режиме Day,
                 отсчёт остаётся видимым при смене режима. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="24,0,0,0"
                        IsVisible="{Binding IsDayMode}"
                        IsEnabled="{Binding !IsSimpleTimerRunning}">
                <RadioButton Content="{DynamicResource TimerFromList}"
                             IsChecked="{Binding !IsSimpleTimerManual}" />
                <RadioButton Content="{DynamicResource TimerManual}"
                             IsChecked="{Binding IsSimpleTimerManual}" />
            </StackPanel>
            <ComboBox Margin="8,0,0,0" MinWidth="100"
                      IsVisible="{Binding IsDayModeAndListMode}"
                      IsEnabled="{Binding !IsSimpleTimerRunning}"
                      ItemsSource="{Binding SimpleTimerOptions}"
                      SelectedItem="{Binding SimpleTimerMinutes, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="sys:Int32">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding}" />
                            <TextBlock Text="{DynamicResource MinShort}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <NumericUpDown Margin="8,0,0,0" Width="110"
                           IsVisible="{Binding IsDayModeAndManualMode}"
                           IsEnabled="{Binding !IsSimpleTimerRunning}"
                           Minimum="1" Maximum="720" Increment="1"
                           Value="{Binding SimpleTimerManualMinutes, Mode=TwoWay}" />
            <Button Content="{DynamicResource TimerStart}"
                    Margin="8,0,0,0"
                    IsVisible="{Binding IsDayMode}"
                    IsEnabled="{Binding !IsSimpleTimerRunning}"
                    Command="{Binding StartSimpleTimerCommand}" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding IsSimpleTimerRunning}"
                       FontWeight="SemiBold"
                       Text="{Binding SimpleTimeLeftText}" />
            <Button Content="{DynamicResource Cancel}"
                    Margin="8,0,0,0"
                    IsVisible="{Binding IsSimpleTimerRunning}"
                    Command="{Binding CancelSimpleTimerCommand}" />
            <Button Content="{DynamicResource Edit}" Margin="24,0,0,0"
                    Command="{Binding EditTaskCommand}"
                    IsEnabled="{Binding CanEditTask}" />
            <Button Content="{DynamicResource Delete}"
                    Command="{Binding DeleteTaskCommand}"
                    IsEnabled="{Binding CanEditTask}" />
            <Button Content="{DynamicResource Refresh}" Margin="24,0,0,0"
                    Command="{Binding RefreshCommand}" />
            <Button Content="{DynamicResource NewTask}" Margin="24,0,0,0"
                    Command="{Binding OpenNewTaskCommand}"/>
            <Button Content="{DynamicResource Settings}" Margin="24,0,0,0"
                    Command="{Binding OpenSettingsCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
