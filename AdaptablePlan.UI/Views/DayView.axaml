<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             xmlns:models="using:AdaptablePlan.UI.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="AdaptablePlan.UI.Views.DayView"
             x:DataType="vm:MainWindowViewModel">
    <!-- Day view: vertical list of the selected day's items -->
    <ListBox ItemsSource="{Binding Schedule}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="MinHeight" Value="20" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ScheduleItem">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,2">
                    <TextBlock MinWidth="50" Text="{Binding StartTime}" />
                    <TextBlock MinWidth="50" Text="{Binding EndTime}" />
                    <TextBlock Text="{Binding Activity}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
