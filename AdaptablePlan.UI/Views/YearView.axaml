<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="AdaptablePlan.UI.Views.YearView"
             x:DataType="vm:MainWindowViewModel">
    <!-- Общий шаблон чек-листа: режим Year (планы на год) и отчёты
         Custom-страниц видов List/Year. Источник данных — ChecklistEntries. -->
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding ChecklistTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding ChecklistEntries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomEntryViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        <Button Content="✕" Padding="4,0" Click="OnRemoveClick" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
            <TextBox Width="280" PlaceholderText="New item" Text="{Binding NewChecklistText, Mode=TwoWay}" />
            <Button Content="Add" Command="{Binding AddChecklistEntryCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
