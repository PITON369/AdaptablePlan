<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AdaptablePlan.UI.ViewModels"
        xmlns:converters="using:AdaptablePlan.UI.Converters"
        xmlns:views="using:AdaptablePlan.UI.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:DataType="vm:MainWindowViewModel"
        x:Class="AdaptablePlan.UI.MainWindow"
        Title="AdaptablePlan" Width="900" Height="650">
    <Window.Resources>
        <converters:NullToBoolConverter x:Key="NullToBool" />
    </Window.Resources>

    <Grid>
        <Grid IsVisible="{Binding IsMainVisible}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="{Binding AppStatus}" />

                <!-- Day / Week toggle -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Spacing="8" Margin="0,0,0,8">
                    <RadioButton Content="Day" IsChecked="{Binding IsDayView, Mode=TwoWay}" />
                    <RadioButton Content="Week" IsChecked="{Binding IsWeekView, Mode=TwoWay}" />
                    <CheckBox Content="Start week on Monday"
                              VerticalAlignment="Center"
                              Margin="24,0,0,0"
                              IsChecked="{Binding StartWeekOnMonday, Mode=TwoWay}"
                              IsVisible="{Binding IsWeekView}" />
                </StackPanel>

                <!-- Schedule list -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Schedule}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,2">
                                <TextBlock Width="60" Text="{Binding DayName}"
                                           IsVisible="{Binding $parent[Window].DataContext.IsWeekView}" />
                                <TextBlock Width="100" Text="{Binding StartTime}" />
                                <TextBlock Width="100" Text="{Binding EndTime}" />
                                <TextBlock Text="{Binding Activity}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            Spacing="8" Margin="0,8,0,0">
                    <Button Content="{Binding DayStartedText}"
                            Command="{Binding ToggleDayCommand}" />
                    <Button Content="Finish Task"
                            Command="{Binding FinishCurrentTaskCommand}" />
                    <Button Content="Edit" Margin="24,0,0,0"
                            Command="{Binding EditTaskCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBool}}" />
                    <Button Content="Delete"
                            Command="{Binding DeleteTaskCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBool}}" />
                    <Button Content="Refresh" Margin="24,0,0,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="New task" Margin="24,0,0,0"
                            Command="{Binding OpenNewTaskCommand}"/>
                    <Button Content="Settings" Margin="24,0,0,0"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Settings -->
        <Grid IsVisible="{Binding IsSettingsOpen}" Margin="16">
            <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBlock FontWeight="SemiBold" FontSize="18" Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Database" />
                    <Button Content="Delete database"
                            HorizontalAlignment="Left"
                            Command="{Binding RequestDeleteDatabaseCommand}" />

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding ConfirmDeleteDb}">
                        <TextBlock Text="Delete all data? This cannot be undone."
                                   VerticalAlignment="Center" />
                        <Button Content="Yes, delete"
                                Command="{Binding DeleteDatabaseCommand}" />
                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteDatabaseCommand}"
                                Classes="secondary" />
                    </StackPanel>
                </StackPanel>

                <Button Content="Close" HorizontalAlignment="Right"
                        Command="{Binding CloseSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- New Task / Edit Task form -->
        <views:NewTaskEntryView Margin="16" IsVisible="{Binding IsNewTaskOpen}" />
    </Grid>
</Window>
