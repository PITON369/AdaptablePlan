<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AdaptablePlan.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- App color scheme: neutral grays that follow the system Light/Dark theme.
                 Referenced from the week grid via {DynamicResource ...}. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WeekGridHeaderBackground" Color="#EFEFEF" />
                    <SolidColorBrush x:Key="WeekGridTimeBackground" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="WeekGridLineBrush" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="WeekGridSelectedBackground" Color="#2F7DE1" />
                    <SolidColorBrush x:Key="WeekGridSelectedForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunningBackground" Color="#B3E5B3" />
                    <SolidColorBrush x:Key="DoneBackground" Color="#A5D6A7" />
                    <SolidColorBrush x:Key="DbErrorBannerBackground" Color="#B3261E" />
                    <SolidColorBrush x:Key="DbErrorBannerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DbBackupBannerBackground" Color="#F9A825" />
                    <SolidColorBrush x:Key="DbBackupBannerForeground" Color="#212121" />
                    <SolidColorBrush x:Key="DialogOverlayBackground" Color="#66000000" />
                    <SolidColorBrush x:Key="DialogCardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DialogCardForeground" Color="#212121" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WeekGridHeaderBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="WeekGridTimeBackground" Color="#2E2E2E" />
                    <SolidColorBrush x:Key="WeekGridLineBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="WeekGridSelectedBackground" Color="#4C8DF6" />
                    <SolidColorBrush x:Key="WeekGridSelectedForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunningBackground" Color="#2E5B2E" />
                    <SolidColorBrush x:Key="DoneBackground" Color="#3E6B3E" />
                    <SolidColorBrush x:Key="DbErrorBannerBackground" Color="#C62828" />
                    <SolidColorBrush x:Key="DbErrorBannerForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DbBackupBannerBackground" Color="#FFD54F" />
                    <SolidColorBrush x:Key="DbBackupBannerForeground" Color="#212121" />
                    <SolidColorBrush x:Key="DialogOverlayBackground" Color="#66000000" />
                    <SolidColorBrush x:Key="DialogCardBackground" Color="#2E2E2E" />
                    <SolidColorBrush x:Key="DialogCardForeground" Color="#F0F0F0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>