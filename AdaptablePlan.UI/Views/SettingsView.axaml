<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:converters="using:AdaptablePlan.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="AdaptablePlan.UI.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Resources>
        <converters:ThemeDisplayConverter x:Key="ThemeDisplayConverter" />
        <converters:LanguageDisplayConverter x:Key="LanguageDisplayConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="12" VerticalAlignment="Top" Margin="16">
        <TextBlock FontWeight="SemiBold" FontSize="18" Text="{DynamicResource SettingsHeader}" />

        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource ScheduleSection}" />
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.ColumnSpan="3" Grid.Row="0"
                          Content="{DynamicResource AutoStartNext}"
                          IsChecked="{Binding AutoStartNextTask, Mode=TwoWay}" />
                <CheckBox Grid.ColumnSpan="3" Grid.Row="1"
                          Content="{DynamicResource HideUnshifted}"
                          IsChecked="{Binding HideUnshiftedTime, Mode=TwoWay}" />
                <CheckBox Grid.ColumnSpan="3" Grid.Row="2"
                          Content="{DynamicResource WrapFixedTasks}"
                          IsChecked="{Binding WrapAroundFixedTasks, Mode=TwoWay}" />
                <!-- План-время до границы дня относится к предыдущему дню -->
                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{DynamicResource DayStartsAt}" />
                <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                         Text="{Binding DayStartText}" Width="80" PlaceholderText="07:30"
                         TextInput="OnTimeTextInput" TextChanged="OnTimeTextChanged" />
                <!-- Пусто - стандартный системный звук окончания -->
                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{DynamicResource TimeupSound}" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SoundFile}" />
                <Button Grid.Row="4" Grid.Column="2"
                        Content="{DynamicResource Browse}" Click="OnBrowseSound" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Appearance}" />
            <Grid RowSpacing="8" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{DynamicResource FontSize}" />
                <Slider Grid.Row="0" Grid.Column="1" Maximum="24" Minimum="10"
                        Value="{Binding FontSize, Mode=TwoWay}" />
                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                           Text="{Binding FontSize, StringFormat={}{0:0}}" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{DynamicResource Theme}" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                          SelectedItem="{Binding Theme, Mode=TwoWay}" Width="150">
                    <sys:String>System</sys:String>
                    <sys:String>Light</sys:String>
                    <sys:String>Dark</sys:String>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ThemeDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{DynamicResource Language}" />
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                          SelectedItem="{Binding Language, Mode=TwoWay}" Width="150">
                    <sys:String>System</sys:String>
                    <sys:String>English</sys:String>
                    <sys:String>Russian</sys:String>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LanguageDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Database}" />
            <Button Content="{DynamicResource DeletePastOneTime}"
                    HorizontalAlignment="Left"
                    Command="{Binding DeletePastOneTimeTasksCommand}" />
            <Button Content="{DynamicResource DeleteDatabase}"
                    HorizontalAlignment="Left"
                    Command="{Binding RequestDeleteDatabaseCommand}" />

            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding ConfirmDeleteDb}">
                <TextBlock Text="{DynamicResource DeleteConfirm}"
                           VerticalAlignment="Center" />
                <Button Content="{DynamicResource YesDelete}"
                        Command="{Binding DeleteDatabaseCommand}" />
                <Button Content="{DynamicResource Cancel}"
                        Command="{Binding CancelDeleteDatabaseCommand}" />
            </StackPanel>
        </StackPanel>

        <Button Content="{DynamicResource Close}" HorizontalAlignment="Right"
                Command="{Binding CloseSettingsCommand}" />
    </StackPanel>
</UserControl>
