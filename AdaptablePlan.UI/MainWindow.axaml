<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AdaptablePlan.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:DataType="vm:MainWindowViewModel"
        x:Class="AdaptablePlan.UI.MainWindow"
        FontSize="{Binding FontSize}"
        Title="AdaptablePlan" Width="1400" Height="700">
    <Grid RowDefinitions="Auto,*">
        <!-- DB banners: yellow = server down, loaded from local SQLite backup;
             red = no database at all, default data shown -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsServerDown}"
                Background="{DynamicResource DbBackupBannerBackground}"
                Padding="12,8">
            <TextBlock Foreground="{DynamicResource DbBackupBannerForeground}"
                       FontWeight="SemiBold"
                       Text="{Binding DbBannerText}" />
        </Border>
        <Border Grid.Row="0"
                IsVisible="{Binding IsDatabaseError}"
                Background="{DynamicResource DbErrorBannerBackground}"
                Padding="12,8">
            <TextBlock Foreground="{DynamicResource DbErrorBannerForeground}"
                       FontWeight="SemiBold"
                       Text="{Binding DbBannerText}" />
        </Border>

        <!-- Single slot: code-behind swaps MainView / SettingsView here -->
        <Grid Grid.Row="1">
            <ContentControl x:Name="PageHost" />

            <!-- Task editor: panel on the right over the schedule, so the
                 schedule stays visible while editing; on a narrow window it
                 overlaps the schedule. Transparent blocker eats clicks going
                 to the schedule (правка должна сохранить в ту же таску). -->
            <Border x:Name="InputBlocker" IsVisible="False" Background="Transparent" />
            <Border x:Name="EditPanel" IsVisible="False"
                    HorizontalAlignment="Right" Width="440"
                    Background="{DynamicResource DialogCardBackground}"
                    BorderBrush="{DynamicResource WeekGridLineBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <ContentControl x:Name="EditHost" />
                </ScrollViewer>
            </Border>

            <!-- Time is up: оверлей вместо отдельного окна, чтобы одинаково
                 работать и на телефоне -->
            <Border IsVisible="{Binding IsTimeUpOpen}"
                    Background="{DynamicResource DialogOverlayBackground}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource DialogCardBackground}"
                        BorderBrush="{DynamicResource WeekGridLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24"
                        MinWidth="280">
                    <StackPanel Spacing="16">
                        <TextBlock Foreground="{DynamicResource DialogCardForeground}"
                                   FontSize="20" FontWeight="Bold"
                                   Text="{DynamicResource TimeIsUp}" />
                        <TextBlock Foreground="{DynamicResource DialogCardForeground}"
                                   Text="{Binding TimeUpTaskName}" />
                        <Button Content="{DynamicResource OK}" HorizontalAlignment="Center"
                                MinHeight="44" Padding="16,8"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding OkTimeUpCommand}" />
                    </StackPanel>
                </Border>
            </Border>
            <!-- Simple timer done: тот же паттерн оверлея, что и "Time is up" -->
            <Border IsVisible="{Binding IsSimpleTimerDone}"
                    Background="{DynamicResource DialogOverlayBackground}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource DialogCardBackground}"
                        BorderBrush="{DynamicResource WeekGridLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24"
                        MinWidth="280">
                    <StackPanel Spacing="16">
                        <TextBlock Foreground="{DynamicResource DialogCardForeground}"
                                   FontSize="20" FontWeight="Bold"
                                   Text="{DynamicResource TimerDone}" />
                        <Button Content="{DynamicResource OK}" HorizontalAlignment="Center"
                                MinHeight="44" Padding="16,8"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding OkSimpleTimerDoneCommand}" />
                    </StackPanel>
                </Border>
            </Border>
            <!-- Автоудаление годовалых разовых тасок: подтверждение со списком -->
            <Border IsVisible="{Binding IsOldOneTimeConfirmOpen}"
                    Background="{DynamicResource DialogOverlayBackground}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource DialogCardBackground}"
                        BorderBrush="{DynamicResource WeekGridLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24"
                        MinWidth="280" MaxWidth="480">
                    <StackPanel Spacing="16">
                        <TextBlock Foreground="{DynamicResource DialogCardForeground}"
                                   FontSize="20" FontWeight="Bold"
                                   Text="{DynamicResource DeleteOldOneTime}" />
                        <TextBlock Foreground="{DynamicResource DialogCardForeground}"
                                   Text="{Binding OldOneTimeNames}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Button Content="{DynamicResource YesDelete}" MinHeight="44" Padding="16,8"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding ConfirmDeleteOldOneTimeCommand}" />
                            <Button Content="{DynamicResource Cancel}" MinHeight="44" Padding="16,8"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Command="{Binding CancelDeleteOldOneTimeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
            <!-- Нечего удалять: сообщение вместо пустого срабатывания кнопки -->
            <Border IsVisible="{Binding IsNoOneTimeOpen}"
                    Background="{DynamicResource DialogOverlayBackground}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource DialogCardBackground}"
                        BorderBrush="{DynamicResource WeekGridLineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="24"
                        MinWidth="280">
                    <StackPanel Spacing="16">
                        <TextBlock Foreground="{DynamicResource DialogCardForeground}"
                                   Text="{DynamicResource NoOneTimeTasks}" />
                        <Button Content="{DynamicResource OK}" HorizontalAlignment="Center"
                                MinHeight="44" Padding="16,8"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding OkNoOneTimeCommand}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
