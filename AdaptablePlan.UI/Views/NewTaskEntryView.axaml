<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             xmlns:models="using:AdaptablePlan.Core.Models"
             xmlns:converters="using:AdaptablePlan.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="AdaptablePlan.UI.Views.NewTaskEntryView"
             x:DataType="vm:MainWindowViewModel"
             Padding="16">
    <UserControl.Resources>
        <converters:TaskTypeDisplayConverter x:Key="TaskTypeDisplayConverter" />
        <!-- TimePickerThemeMinWidth: перекрытие ресурса темы Fluent (там 242),
             иначе пикер времени не сжимается уже "~чч:мм" -->
        <x:Double x:Key="TimePickerThemeMinWidth">90</x:Double>
    </UserControl.Resources>
    <StackPanel Spacing="12" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" FontSize="18"
                       IsVisible="{Binding !IsEditing}"
                       Text="{DynamicResource NewTaskHeader}" />
            <TextBlock FontWeight="SemiBold" FontSize="18"
                       IsVisible="{Binding IsEditing}"
                       Text="{DynamicResource EditTaskHeader}" />
        </StackPanel>

        <TextBlock Text="{Binding ValidationMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasValidationMessage}" />

        <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Type}" />
            <ComboBox ItemsSource="{Binding TaskTypes}"
                      SelectedValue="{Binding CurrentTask.Type}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource TaskTypeDisplayConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding CurrentTaskTypeDescription}"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Name}" />
            <TextBox Text="{Binding CurrentTask.Name}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding ShowDuration}">
            <TextBlock Text="{DynamicResource DurationMin}" />
            <TextBox Text="{Binding DurationText}"
                     PlaceholderText="{DynamicResource DurationPlaceholder}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding ShowTimeVariants}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{DynamicResource Times}"
                           VerticalAlignment="Center" />
                <Button Content="{DynamicResource AddTime}"
                        Command="{Binding AddTimeVariantCommand}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding TimeVariants}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskTimeVariantViewModel">
                        <StackPanel Spacing="2" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource Start}" VerticalAlignment="Center" />
                                <TimePicker SelectedTime="{Binding StartValue, Mode=TwoWay}"
                                            ClockIdentifier="24HourClock" />
                                <TextBlock Text="{DynamicResource End}" VerticalAlignment="Center" />
                                <TimePicker SelectedTime="{Binding EndValue, Mode=TwoWay}"
                                            ClockIdentifier="24HourClock" />
                                <Button Content="{DynamicResource Remove}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveTimeVariantCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                            <UniformGrid Rows="1" Columns="7" Margin="0,2,0,0">
                                <CheckBox Content="{DynamicResource Mon}" IsChecked="{Binding Mon}" />
                                <CheckBox Content="{DynamicResource Tue}" IsChecked="{Binding Tue}" />
                                <CheckBox Content="{DynamicResource Wed}" IsChecked="{Binding Wed}" />
                                <CheckBox Content="{DynamicResource Thu}" IsChecked="{Binding Thu}" />
                                <CheckBox Content="{DynamicResource Fri}" IsChecked="{Binding Fri}" />
                                <CheckBox Content="{DynamicResource Sat}" IsChecked="{Binding Sat}" />
                                <CheckBox Content="{DynamicResource Sun}" IsChecked="{Binding Sun}" />
                            </UniformGrid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{DynamicResource Cancel}" Command="{Binding CancelNewTaskCommand}" />
            <Button Content="{DynamicResource Save}" Command="{Binding SaveNewTaskCommand}"
                    IsVisible="{Binding !IsEditing}"
                    IsDefault="True" />
            <Button Content="{DynamicResource Update}" Command="{Binding SaveNewTaskCommand}"
                    IsVisible="{Binding IsEditing}"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
