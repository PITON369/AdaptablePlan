<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AdaptablePlan.UI.ViewModels"
        xmlns:converters="using:AdaptablePlan.UI.Converters"
        xmlns:views="using:AdaptablePlan.UI.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:DataType="vm:MainWindowViewModel"
        x:Class="AdaptablePlan.UI.MainWindow"
        Title="AdaptablePlan" Width="900" Height="650">
    <Window.Resources>
        <converters:NullToBoolConverter x:Key="NullToBool" />
    </Window.Resources>

    <Grid>
        <Grid IsVisible="{Binding !IsNewTaskOpen}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="{Binding AppStatus}" />

                <!-- Schedule list -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Schedule}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,2">
                                <TextBlock Width="100" Text="{Binding StartTime}" />
                                <TextBlock Width="100" Text="{Binding EndTime}" />
                                <TextBlock Text="{Binding Activity}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            Spacing="8" Margin="0,8,0,0">
                    <Button Content="{Binding DayStartedText}"
                            Command="{Binding ToggleDayCommand}" />
                    <Button Content="Finish Task"
                            Command="{Binding FinishCurrentTaskCommand}" />
                    <Button Content="Edit" Margin="24,0,0,0"
                            Command="{Binding EditEntryCommand}"
                            IsEnabled="{Binding SelectedEntry, Converter={StaticResource NullToBool}}" />
                    <Button Content="Delete"
                            Command="{Binding DeleteEntryCommand}"
                            IsEnabled="{Binding SelectedEntry, Converter={StaticResource NullToBool}}" />
                    <Button Content="New task" Margin="24,0,0,0"
                            Command="{Binding OpenNewTaskCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- New Task form overlay -->
        <views:NewTaskEntryView Margin="16" IsVisible="{Binding IsNewTaskOpen}" />

        <!-- Edit Schedule Entry form overlay -->
        <Grid IsVisible="{Binding IsEditingEntry}">
            <Border Background="White"
                    Margin="100"
                    CornerRadius="8">
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock FontWeight="SemiBold" FontSize="18" Text="Edit Task" />

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" Text="Name" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding EditEntryActivity}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" Text="Start" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding EditEntryStartTime}"
                                 PlaceholderText="HH:MM" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,8,8,0" Text="End" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Margin="0,8,0,0"
                                 Text="{Binding EditEntryEndTime}"
                                 PlaceholderText="HH:MM" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditEntryCommand}"
                                Classes="secondary" />
                        <Button Content="Save"
                                Command="{Binding SaveEntryCommand}"
                                IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
