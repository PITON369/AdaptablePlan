<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AdaptablePlan.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:DataType="vm:MainWindowViewModel"
        x:Class="AdaptablePlan.UI.MainWindow"
        Title="AdaptablePlan" Width="900" Height="650">
    <Grid RowDefinitions="Auto,*">
        <!-- DB banners: yellow = server down, loaded from local SQLite backup;
             red = no database at all, default data shown -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsServerDown}"
                Background="{DynamicResource DbBackupBannerBackground}"
                Padding="12,8">
            <TextBlock Foreground="{DynamicResource DbBackupBannerForeground}"
                       FontWeight="SemiBold"
                       Text="{Binding DbBannerText}" />
        </Border>
        <Border Grid.Row="0"
                IsVisible="{Binding IsDatabaseError}"
                Background="{DynamicResource DbErrorBannerBackground}"
                Padding="12,8">
            <TextBlock Foreground="{DynamicResource DbErrorBannerForeground}"
                       FontWeight="SemiBold"
                       Text="{Binding DbBannerText}" />
        </Border>

        <!-- Single slot: code-behind swaps MainView / SettingsView / NewTaskEntryView here -->
        <ContentControl Grid.Row="1" x:Name="PageHost" />
    </Grid>
</Window>
