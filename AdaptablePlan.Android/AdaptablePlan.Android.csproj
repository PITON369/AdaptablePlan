<!--
TODO: Перед сборкой Android-проекта:

  1. Установить Android workload:
     dotnet workload install android

  2. Раскомментировать проект в AdaptablePlan.sln
     (строки с GUID {11111111-1111-1111-1111-111111111104})

  3. Проверить версии пакетов:
     - Avalonia.Maui — совместима ли с версией Avalonia в UI-проекте
     - Microsoft.Maui.* — соответствует ли установленному workload

  4. Настроить ApplicationId (com.adaptableplan.app) под реальный пакет

  5. Добавить ресурсы Android:
     - иконки (Resources/mipmap-*/ic_launcher.png)
     - splash screen
     - AndroidManifest.xml (разрешения INTERNET и т.д.)
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <Nullable>enable</Nullable>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationId>com.adaptableplan.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportsTablet>true</SupportsTablet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Maui" Version="12.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaptablePlan.UI\AdaptablePlan.UI.csproj" />
  </ItemGroup>
</Project>
