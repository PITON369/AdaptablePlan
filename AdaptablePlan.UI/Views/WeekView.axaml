<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="AdaptablePlan.UI.Views.WeekView"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- Классы назначаются элементам, собранным в code-behind.
             selected идёт после running, чтобы выделение побеждало. -->
        <Style Selector="Button.task">
            <Setter Property="Background" Value="{DynamicResource WeekGridTaskBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WeekGridTaskBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.task.running">
            <Setter Property="Background" Value="{DynamicResource RunningBackground}" />
        </Style>
        <Style Selector="Button.task.selected">
            <Setter Property="Background" Value="{DynamicResource WeekGridSelectedBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource WeekGridSelectedForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.colhdr">
            <Setter Property="Background" Value="{DynamicResource WeekGridHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WeekGridLineBrush}" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style Selector="Border.colhdr.selected">
            <Setter Property="Background" Value="{DynamicResource WeekGridSelectedBackground}" />
        </Style>
        <Style Selector="Border.timecol">
            <Setter Property="Background" Value="{DynamicResource WeekGridTimeBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WeekGridLineBrush}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Border.gridcell">
            <Setter Property="BorderBrush" Value="{DynamicResource WeekGridLineBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Таблица недели собирается в code-behind: задачи занимают одну ячейку
         на все свои строки (Grid.RowSpan), поэтому пустых повторов нет. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Table" />
    </ScrollViewer>
</UserControl>
