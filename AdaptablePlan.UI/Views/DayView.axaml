
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AdaptablePlan.UI.ViewModels"
             xmlns:models="using:AdaptablePlan.UI.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="AdaptablePlan.UI.Views.DayView"
             x:DataType="vm:MainWindowViewModel">
    <!-- CheckBoxMinHeight: перекрытие ресурса темы Fluent (там 32) — иначе строка списка не ниже 32px -->
    <UserControl.Resources>
        <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.running">
            <Setter Property="Background" Value="{DynamicResource RunningBackground}" />
        </Style>
        <Style Selector="Border.done">
            <Setter Property="Background" Value="{DynamicResource DoneBackground}" />
        </Style>
    </UserControl.Styles>
    <!-- Day view: vertical list of the selected day's items. Заголовок и список
         в одной shared-size области: подписи выравниваются с колонками строк -->
    <Grid RowDefinitions="Auto,*" Grid.IsSharedSizeScope="True">
        <Grid Grid.Row="0" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="BaseStart" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="BaseEnd" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Start" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="End" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Activity" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,5,0"
                       IsVisible="{Binding !HideUnshiftedTime}" Text="{DynamicResource Plan}" />
            <TextBlock Grid.Column="1" Margin="0,0,5,0"
                       IsVisible="{Binding !HideUnshiftedTime}" />
            <Border Grid.Column="2" Width="1" Margin="2,0"
                    Background="{DynamicResource WeekGridLineBrush}"
                    IsVisible="{Binding !HideUnshiftedTime}" />
            <TextBlock Grid.Column="3" Margin="0,0,5,0" Text="{DynamicResource Shift}" />
            <TextBlock Grid.Column="4" Margin="0,0,5,0" />
            <Border Grid.Column="5" Width="1" Margin="2,0"
                    Background="{DynamicResource WeekGridLineBrush}" />
            <TextBlock Grid.Column="6" Margin="0,0,5,0" Text="{DynamicResource Task}" />
        </Grid>
        <ListBox Grid.Row="1"
             ItemsSource="{Binding Schedule}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             DoubleTapped="OnListDoubleTapped">
        <!-- Без виртуализации (StackPanel вместо VirtualizingStackPanel):
             SharedSizeGroup сразу считает ширину по всем строкам, включая
             самую длинную, и колонки не прыгают при прокрутке -->
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="16" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ScheduleItem">
                <Border Classes.running="{Binding IsRunning}" CornerRadius="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseStart" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseEnd" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Start" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="End" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Activity" />
                            <ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <!-- Базовое время по плану: рядом со сдвинутым, чтобы
                             видеть, откуда таска на экране; прячется настройкой -->
                        <TextBlock Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center"
                                   IsVisible="{Binding !$parent[ItemsControl].DataContext.HideUnshiftedTime}"
                                   Text="{Binding BaseStartTime}" />
                        <TextBlock Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center"
                                   IsVisible="{Binding !$parent[ItemsControl].DataContext.HideUnshiftedTime}"
                                   Text="{Binding BaseEndTime}" />
                        <Border Grid.Column="2" Width="1" Margin="2,0"
                                Background="{DynamicResource WeekGridLineBrush}"
                                IsVisible="{Binding !$parent[ItemsControl].DataContext.HideUnshiftedTime}" />
                        <TextBlock Grid.Column="3" Margin="0,0,5,0" VerticalAlignment="Center" Text="{Binding StartTime}" />
                        <TextBlock Grid.Column="4" Margin="0,0,5,0" VerticalAlignment="Center" Text="{Binding EndTime}" />
                        <Border Grid.Column="5" Width="1" Margin="2,0"
                                Background="{DynamicResource WeekGridLineBrush}" />
                        <Border Grid.Column="6" Margin="0,0,5,0"
                                Classes.done="{Binding IsDone}"
                                CornerRadius="2">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Activity}" />
                        </Border>
                        <CheckBox Grid.Column="7" MinHeight="0" MinWidth="0" Padding="0"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsToday}"
                                  IsChecked="{Binding IsDone, Mode=OneWay}"
                                  Click="OnDoneClick" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
