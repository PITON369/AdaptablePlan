<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AdaptablePlan.UI.ViewModels"
        xmlns:converters="using:AdaptablePlan.UI.Converters"
        xmlns:views="using:AdaptablePlan.UI.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:DataType="vm:MainWindowViewModel"
        x:Class="AdaptablePlan.UI.MainWindow"
        Title="AdaptablePlan" Width="900" Height="650">
    <Window.Resources>
        <converters:NullToBoolConverter x:Key="NullToBool" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.selected">
            <Setter Property="Background" Value="{DynamicResource WeekGridSelectedBackground}" />
        </Style>
        <Style Selector="Border.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WeekGridSelectedForeground}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- DB banners: yellow = server down, loaded from local SQLite backup;
             red = no database at all, default data shown -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsServerDown}"
                Background="{DynamicResource DbBackupBannerBackground}"
                Padding="12,8">
            <TextBlock Foreground="{DynamicResource DbBackupBannerForeground}"
                       FontWeight="SemiBold"
                       Text="{Binding DbBannerText}" />
        </Border>
        <Border Grid.Row="0"
                IsVisible="{Binding IsDatabaseError}"
                Background="{DynamicResource DbErrorBannerBackground}"
                Padding="12,8">
            <TextBlock Foreground="{DynamicResource DbErrorBannerForeground}"
                       FontWeight="SemiBold"
                       Text="{Binding DbBannerText}" />
        </Border>

        <Grid Grid.Row="1">
        <Grid IsVisible="{Binding IsMainVisible}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="{Binding AppStatus}" />

                <!-- Day / Week toggle -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Spacing="8" Margin="0,0,0,8">
                    <RadioButton Content="Day" IsChecked="{Binding IsDayView, Mode=TwoWay}" />
                    <RadioButton Content="Week" IsChecked="{Binding IsWeekView, Mode=TwoWay}" />
                    <CheckBox Content="Start week on Monday"
                              VerticalAlignment="Center"
                              Margin="24,0,0,0"
                              IsChecked="{Binding StartWeekOnMonday, Mode=TwoWay}"
                              IsVisible="{Binding IsWeekView}" />
                </StackPanel>

                <!-- Day view: vertical list -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Schedule}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         IsVisible="{Binding IsDayView}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScheduleItem">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,2">
                                <TextBlock MinWidth="50" Text="{Binding StartTime}" />
                                <TextBlock MinWidth="50" Text="{Binding EndTime}" />
                                <TextBlock Text="{Binding Activity}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Week view: horizontal timetable (days on top, time on the left) -->
                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding IsWeekView}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Day headers -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="90" Padding="4,3"
                                    Background="{DynamicResource WeekGridHeaderBackground}"
                                    BorderBrush="{DynamicResource WeekGridLineBrush}"
                                    BorderThickness="1,1,1,1">
                                <TextBlock Text="Time" FontWeight="SemiBold" TextAlignment="Right" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding WeekDayHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WeekDayHeader">
                                        <Border Width="{Binding ColumnWidth}" Padding="4,3"
                                                Background="{DynamicResource WeekGridHeaderBackground}"
                                                BorderBrush="{DynamicResource WeekGridLineBrush}"
                                                BorderThickness="0,1,1,1"
                                                Classes.selected="{Binding IsSelected}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Time rows -->
                        <ItemsControl ItemsSource="{Binding WeekRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WeekRow">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="90" Padding="4,2"
                                                Background="{DynamicResource WeekGridTimeBackground}"
                                                BorderBrush="{DynamicResource WeekGridLineBrush}"
                                                BorderThickness="1,1,0,1">
                                            <TextBlock Text="{Binding TimeLabel}" FontSize="11"
                                                       TextAlignment="Right" TextWrapping="Wrap" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WeekCell">
                                                    <Border Width="{Binding ColumnWidth}" MinHeight="22" Padding="1"
                                                            BorderBrush="{DynamicResource WeekGridLineBrush}"
                                                            BorderThickness="0,1,1,1">
                                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ScheduleItem">
                                                                    <Button FontSize="11"
                                                                            Padding="3,1"
                                                                            MinHeight="18"
                                                                            HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Left"
                                                                            Click="OnCellButtonClick"
                                                                            Classes.selected="{Binding IsSelected}">
                                                                        <TextBlock Text="{Binding Activity}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button.Styles>
                                                                            <Style Selector="Button">
                                                                                <Setter Property="Background"
                                                                                        Value="Transparent" />
                                                                                <Setter Property="BorderThickness"
                                                                                        Value="0" />
                                                                            </Style>
                                                                            <Style Selector="Button.selected">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource WeekGridSelectedBackground}" />
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource WeekGridSelectedForeground}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </Style>
                                                                        </Button.Styles>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            Spacing="8" Margin="0,8,0,0">
                    <Button Content="{Binding DayStartedText}"
                            Command="{Binding ToggleDayCommand}" />
                    <Button Content="Finish Task"
                            Command="{Binding FinishCurrentTaskCommand}" />
                    <TextBlock VerticalAlignment="Center" Margin="24,0,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedTimeText}" />
                    <Button Content="Edit" Margin="24,0,0,0"
                            Command="{Binding EditTaskCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBool}}" />
                    <Button Content="Delete"
                            Command="{Binding DeleteTaskCommand}"
                            IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBool}}" />
                    <Button Content="Refresh" Margin="24,0,0,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="New task" Margin="24,0,0,0"
                            Command="{Binding OpenNewTaskCommand}"/>
                    <Button Content="Settings" Margin="24,0,0,0"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Settings -->
        <Grid IsVisible="{Binding IsSettingsOpen}" Margin="16">
            <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBlock FontWeight="SemiBold" FontSize="18" Text="Settings" />

                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Database" />
                    <Button Content="Delete database"
                            HorizontalAlignment="Left"
                            Command="{Binding RequestDeleteDatabaseCommand}" />

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding ConfirmDeleteDb}">
                        <TextBlock Text="Delete all data? This cannot be undone."
                                   VerticalAlignment="Center" />
                        <Button Content="Yes, delete"
                                Command="{Binding DeleteDatabaseCommand}" />
                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteDatabaseCommand}"
                                Classes="secondary" />
                    </StackPanel>
                </StackPanel>

                <Button Content="Close" HorizontalAlignment="Right"
                        Command="{Binding CloseSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- New Task / Edit Task form -->
        <views:NewTaskEntryView Margin="16" IsVisible="{Binding IsNewTaskOpen}" />
        </Grid>
    </Grid>
</Window>
